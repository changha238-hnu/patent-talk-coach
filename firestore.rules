rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Visitors can only send messages; nobody can read, edit or delete them from the site.
    // The developer reads them in the Firebase console.
    match /messages/{id} {
      allow read, update, delete: if false;
      allow create: if request.resource.data.keys().hasOnly(['name', 'rating', 'text', 'course', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'text', 'course', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && (!('rating' in request.resource.data)
            || (request.resource.data.rating is int
                && request.resource.data.rating >= 1 && request.resource.data.rating <= 5))
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 2 && request.resource.data.text.size() <= 1000
        && request.resource.data.course in ['g', 'p']
        && request.resource.data.createdAt == request.time;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
